; Iron Dust Rally — Godot project file
;
; RECONSTRUCTED 2026-08-23. The project had no project.godot at all, which meant Godot could
; not open the directory as a project AND every autoload registration was gone with it. Five
; names were being called as globals across ~60 sites (UIAtlas alone 36 times) with nothing
; binding them, so the game could not run.
;
; Autoloads below are only the scripts that genuinely qualify, verified individually:
;   ui_atlas.gd     extends Node        -> UIAtlas
;   menu_input.gd   extends Node        -> MenuInput
;   vehicles.gd     extends Node        -> Vehicles
;   tracks.gd       extends Node        -> Tracks
;
; Deliberately NOT autoloads:
;   racer.gd          declares `class_name RallyRacer` and extends CharacterBody2D - it is a
;                     spawned entity, not a singleton. (Code called `Racer.new()`, a name that
;                     does not exist; corrected to `RallyRacer.new()`.)
;   track_geometry.gd extends RefCounted - an autoload must extend Node, so registering this
;                     would fail at startup. It is a preloaded utility.
;   profiles.gd       extends Node and IS referenced, but only through get_node_or_null, so
;                     every call site already handles its absence. Registering it would switch
;                     on name/points persistence - a product decision, not a bug fix, so it is
;                     left off deliberately.
;
; CORRECTED 2026-09-10. The note here used to claim game_state.gd was "passed around explicitly
; rather than referenced as a global anywhere in the current code". That was wrong: six scripts
; call get_node("/root/GameState") - main, title_screen, join_screen, car_select, track_select
; and results. Because it was not registered, the call returned null and main.gd:27 died on
; game_state.track_id, leaving `track` empty and cascading into nine errors on centerline,
; spawns and rocks. The race could not start at all. Booting only loads title_screen.tscn, so
; the headless boot gate reported a clean project the whole time.
;
; main_scene is title_screen: the navigation graph is
; title_screen -> join_screen -> car_select -> track_select -> race -> results -> title_screen,
; and title_screen is the only scene nothing routes back *into* mid-flow.

config_version=5

[application]

config/name="Iron Dust Rally"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

UIAtlas="*res://scripts/ui_atlas.gd"
MenuInput="*res://scripts/menu_input.gd"
Vehicles="*res://scripts/vehicles.gd"
Tracks="*res://scripts/tracks.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
